{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkwell",
  "version": "0.1.0",
  "identifier": "studio.inkwell.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @inkwell/web dev -- --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --filter @inkwell/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inkwell",
        "width": 1280,
        "height": 860,
        "minWidth": 860,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "Inkwell",
    "category": "Productivity",
    "shortDescription": "A writing studio for long-form fiction authors",
    "longDescription": "Inkwell combines manuscript writing, story bible, storyboard, timeline, and a project-scoped AI assistant in one trusted, local-first writing studio."
  },
  "plugins": {}
}
