{
  "expo": {
    "name": "Inkwell",
    "slug": "inkwell",
    "scheme": "inkwell",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1B1F2E"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "studio.inkwell.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "studio.inkwell.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1B1F2E"
      }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "router": { "origin": false }
    }
  }
}
