{
  "name": "inkwell",
  "private": true,
  "version": "0.1.0",
  "description": "Inkwell — an all-in-one writing studio for long-form fiction authors.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @inkwell/web dev",
    "dev:desktop": "pnpm --filter @inkwell/desktop tauri dev",
    "build": "pnpm -r --filter=./packages/** build && pnpm --filter @inkwell/web build",
    "build:desktop": "pnpm --filter @inkwell/desktop tauri build",
    "test": "pnpm -r test",
    "test:rls": "tsx tests/rls/run.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1"
  },
  "packageManager": "pnpm@10.33.0"
}
