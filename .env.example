# Inkwell — environment configuration template.
# Copy to `.env` (git-ignored) and fill in real values. Never commit `.env`.
# See docs/DEPLOYMENT.md for how each of these is used, and
# docs/OWNER_ACTIONS_REQUIRED.md for which of these only a human can obtain.

# ---------------------------------------------------------------------------
# apps/web (Vite) — safe to expose in the browser bundle. Anything NOT
# prefixed VITE_ is never bundled into client code by Vite, which is why the
# Anthropic key below lives only in supabase/functions/.env, never here.
# ---------------------------------------------------------------------------

# From your Supabase project's Settings → API. The anon key is safe for a
# client — Postgres RLS is what actually protects data, not this key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Leave both blank to run the web app in "local-only" mode: no auth, no
# cloud sync, everything persisted to IndexedDB in this browser only. Useful
# for a first look at the app with zero backend setup.

# ---------------------------------------------------------------------------
# supabase/functions/.env — Edge Function secrets. NEVER prefix with VITE_,
# NEVER reference from apps/web, apps/desktop, or apps/mobile.
# ---------------------------------------------------------------------------

# From https://console.anthropic.com/settings/keys — required for the AI
# assistant to do anything beyond the deterministic test provider.
ANTHROPIC_API_KEY=

# Model id Anthropic currently publishes for this account. Verify against
# https://docs.claude.com/en/docs/about-claude/models before deploying —
# do not assume the default below stays current.
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase project settings, needed by Edge Functions to verify the caller's
# JWT and to write with elevated privilege (service role bypasses RLS —
# guard every write path in the function code itself).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Monthly per-user AI token allowance enforced by the ai-assistant function
# before it will call Anthropic at all (see docs/AI_ARCHITECTURE.md).
# New signups get an `entitlements` row automatically with ai_monthly_token_
# allowance defaulting to 200000 AT THE SQL LEVEL (handle_new_user_entitlement,
# migration 0010_billing.sql) — a Postgres trigger can't read this env var, so
# changing it here does NOT change what new signups get; edit that migration's
# default (or `alter table` a deployed project) for that. This env var only
# covers the narrow fallback of a caller somehow having no entitlements row at
# all — see docs/OWNER_ACTIONS_REQUIRED.md for the full explanation.
AI_FREE_PLAN_MONTHLY_TOKEN_ALLOWANCE=200000
# NOT wired to anything yet — no code path creates an `entitlements` row with
# a paid plan_id, so setting this has no effect until real billing exists.
# Kept as a placeholder for that future wiring point, not a working setting.
AI_AUTHOR_PLAN_MONTHLY_TOKEN_ALLOWANCE=2000000

# ---------------------------------------------------------------------------
# Optional integrations — each is fully optional; the app works without any
# of them. Feature-flagged off (docs/OWNER_ACTIONS_REQUIRED.md) until set.
# ---------------------------------------------------------------------------

# Google Cloud Console → OAuth client (Drive backup/export integration).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:5173/integrations/google-drive/callback

# Media generation provider credentials (character portraits, cover concepts,
# scene previs clips). Leave blank to use the deterministic test provider.
MEDIA_PROVIDER=test
MEDIA_PROVIDER_API_KEY=

# Grammar-checking provider (optional; native browser spellcheck works with
# nothing configured).
GRAMMAR_PROVIDER=none
LANGUAGETOOL_API_KEY=

# Billing/entitlement reconciliation — architecture only until an owner
# creates real store listings. See docs/COSTS.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APPLE_SHARED_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Crash reporting (optional). Configure a DSN whose payloads you've verified
# never include manuscript text — see docs/PRIVACY_DATA_FLOW.md.
SENTRY_DSN=
